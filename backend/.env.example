APP_NAME=Chat and AI Assistant API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

SECRET_KEY=replace-with-a-random-secret-before-running
ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_URL=sqlite+aiosqlite:///./data/app.db
AI_DATABASE_URL=sqlite+aiosqlite:///./data/ai.db
CORE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_UNLOCK_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success
STRIPE_CANCEL_URL=http://localhost:5173/payment/cancel

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

CHROMA_PERSIST_DIRECTORY=./data/chroma
UPLOAD_DIRECTORY=./data/uploads
MAX_PDF_SIZE_MB=10
